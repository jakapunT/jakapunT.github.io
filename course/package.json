{
  "name": "course-pages",
  "private": true,
  "type": "module",
  "description": "Builds password-protected lecture pages from Markdown for jakapunt.github.io",
  "scripts": {
    "dev": "node src/dev.mjs",
    "build": "node src/build.mjs",
    "publish": "node src/publish.mjs",
    "check": "node scripts/guard.mjs --all",
    "postinstall": "node scripts/install-hooks.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/anuphan": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/sarabun": "5.3.0",
    "gray-matter": "4.0.3",
    "js-yaml": "5.5.0",
    "katex": "0.19.0",
    "markdown-it": "15.0.3",
    "shiki": "4.5.0",
    "staticrypt": "3.5.4"
  }
}
