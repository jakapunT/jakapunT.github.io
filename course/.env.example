# Copy to .env (same folder) and fill in. .env is gitignored and must never be committed.
# One line per course. Use a long passphrase, not a short word.
COURSE_PASSWORD_NLP_BASIC=change-me-to-a-long-passphrase

# Optional. The local ✎ editor updates English with Claude Code's `claude` command (your
# Claude login, no key needed). Only on a computer without Claude Code, set an API key here.
# ANTHROPIC_API_KEY=
